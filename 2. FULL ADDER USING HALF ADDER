module half_adder(
    input a, b,
    output sum, carry
);

assign sum = a ^ b;
assign carry = a & b;

endmodule


module full_adder(
    input a, b, cin,
    output sum, cout
);

wire s1, c1, c2;

// First Half Adder
half_adder HA1(a, b, s1, c1);

// Second Half Adder
half_adder HA2(s1, cin, sum, c2);

// Final Carry
assign cout = c1 | c2;

endmodule






